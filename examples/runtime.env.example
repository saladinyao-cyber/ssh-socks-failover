SSHF_STATE_DIR=/path/to/state-directory
SSHF_IDENTITY_FILE=/path/to/private-key
SSHF_KNOWN_HOSTS_FILE=/path/to/known_hosts
SSHF_NODE_A_USER=replace-me
SSHF_NODE_B_USER=replace-me
SSHF_NODE_C_USER=replace-me
